import h5py
import torch
import numpy as np
import matplotlib.pyplot as plt
from neuralop.models import FNO

# Configuration
file_path = "---.h5"
checkpoint_path = "./checkpoints/"

initial_steps = 10      # how many past frames the model sees
n_output_steps = 10     # how many steps the model predicts at once, same as in training
t_target = 50        # final timestep to predict
device = "cpu"          # use "cuda" if available

# Load trained model
operator = FNO(
    n_modes=(16, 16, 5),
    hidden_channels=32,
    in_channels=2,
    out_channels=2
)

operator.load_checkpoint(save_folder="./checkpoints", save_name="fno3d_reactiondiff_500")
operator.to(device)
operator.eval()

# Load one trajectory
sample_index = 0
with h5py.File(file_path, "r") as f:
    key = str(sample_index).zfill(4)
    data = np.array(f[f"{key}/data"], dtype=np.float32)  # shape: (T, nx, ny, channels)

# Autoregressive prediction loop (corrected)
pred_sequence = list(data[:initial_steps])  # start with initial_steps frames

while len(pred_sequence) <= t_target:
    # Prepare input: last `initial_steps` frames
    x_input = np.array(pred_sequence[-initial_steps:])          # shape: (initial_steps, nx, ny, channels)
    x_input = np.transpose(x_input, (3, 1, 2, 0))              # (channels, nx, ny, initial_steps)
    x_input = np.expand_dims(x_input, 0)                        # add batch dim: (1, channels, nx, ny, initial_steps)
    x_input = torch.tensor(x_input, dtype=torch.float32).to(device)

    with torch.no_grad():
        y_pred = operator(x_input)                              # shape: (1, channels, nx, ny, n_output_steps)
    
    y_pred = y_pred.squeeze(0).cpu().numpy()                    # (channels, nx, ny, n_output_steps)
    
    # Append predicted frames one by one until we reach t_target
    for i in range(y_pred.shape[-1]):
        if len(pred_sequence) > t_target:
            break
        frame = np.transpose(y_pred[..., i], (1, 2, 0))        # (nx, ny, channels)
        pred_sequence.append(frame)

# Extract prediction and ground truth at target time
y_pred_target = pred_sequence[t_target]                       # predicted frame at t_target
y_true_target = data[t_target]                                 # true frame at t_target

# Plot input, ground truth, and prediction
channel = 1  # which channel to visualize, 0 = activator, 1 = inhibitor

plt.figure(figsize=(12, 4))

plt.subplot(1, 3, 1)
plt.imshow(data[initial_steps, :, :, channel], cmap="viridis")
plt.title("Input (last initial step)")

plt.subplot(1, 3, 2)
plt.imshow(y_true_target[:, :, channel], cmap="viridis")
plt.title(f"Ground truth t={t_target}")

plt.subplot(1, 3, 3)
plt.imshow(y_pred_target[:, :, channel], cmap="viridis")
plt.title(f"Prediction t={t_target}")

plt.show()
